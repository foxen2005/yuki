{
  "name": "yuki",
  "version": "0.3.0",
  "description": "Multi-app desktop client",
  "main": "src/main/index.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&&electron .",
    "start:dev": "set ELECTRON_RUN_AS_NODE=&&electron . --inspect=9229",
    "build": "electron-builder build --win",
    "build:dir": "electron-builder build --win --dir",
    "release": "electron-builder build --win --publish always"
  },
  "build": {
    "appId": "com.yuki.app",
    "productName": "Yuki",
    "copyright": "2025",
    "directories": {
      "output": "dist"
    },
    "icon": "icons/icon.ico",
    "files": [
      "src/**",
      "icons/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yuki",
      "artifactName": "Yuki-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "foxen2005",
        "repo": "yuki",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Yuki-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
